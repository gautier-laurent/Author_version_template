							\end{tabularx}%
							\par
							\vskip 0.3em%
							\hrule
							\vskip 2em%
						]%
					\else
						\newpage
						\global\@topnum\z@   % Prevents figures from going at top of page.
						\@maketitle
						\hrule
						\vskip 0.3em%
						\tabcolsep=0.75em
						\begin{tabularx}{\linewidth}{@{}Xl@{}}%
							{\textbf{Abstract}\quad \abstract} & 
							{\mykeywords} \\%
						\end{tabularx}%
						\par
						\vskip 0.3em%
						\hrule
						\vskip 2em%
					\fi
				% abstract, keyword, and highlights
				\else
					\if@twocolumn
						\twocolumn[
							\newpage
							\global\@topnum\z@   % Prevents figures from going at top of page.
							\@maketitle
							\textbf{Highlights}\par
							\highlights\par
							\vskip 0.5em%
							\hrule
							\vskip 0.3em%
							\tabcolsep=0.75em
							\begin{tabularx}{\linewidth}{@{}Xl@{}}%
								{\textbf{Abstract}\quad \abstract} & 
								{\mykeywords} \\%
							\end{tabularx}%
							\par
							\vskip 0.3em%
							\hrule
							\vskip 2em%
						]%
					\else
						\newpage
						\global\@topnum\z@   % Prevents figures from going at top of page.
						\@maketitle
						\textbf{Highlights}\par
						\highlights\par
						\vskip 0.5em%
						\hrule
						\vskip 0.3em%
						\tabcolsep=0.75em
						\begin{tabularx}{\linewidth}{@{}Xl@{}}%
