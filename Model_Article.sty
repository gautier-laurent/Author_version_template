% With natbib.
% Define a style for the backref. Need the hyperref package.
\newcommand{\mapolicebackref}[1]{
    %\hspace*{\fill} \mbox{\textit {\small #1}}
    \mbox{\textit {#1}}
}
% Handle the backref in the bibliography. Need the hyperref package.
\renewcommand*{\backref}[1]{}
\renewcommand*{\backrefalt}[4]{%
\ifcase #1 \mapolicebackref{(Not cited)}
    \or \mapolicebackref{(Cited page #2)}
    %\else \mapolicebackref{#1 citations pages #2}
    \else \mapolicebackref{(Cited pages #2)}
\fi
}

