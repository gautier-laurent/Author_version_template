						\global\@topnum\z@   % Prevents figures from going at top of page.
						\@maketitle
						\hrule
						\vskip 0.3em%
						\begin{tabularx}{\linewidth}{@{}l@{}X@{}}%
							\textbf{Abstract\quad} & 
							{\abstract} \\%
						\end{tabularx}%
						\par
						\vskip 0.3em%
						\hrule
						\vskip 2em%
					\fi
				% abstract, no keyword, and highlights
				\else
					\if@twocolumn
						\twocolumn[
							\newpage
							\global\@topnum\z@   % Prevents figures from going at top of page.
							\@maketitle
							\hrule
							\vskip 0.3em%
							\begin{tabularx}{\linewidth}{@{}l@{}X@{}}%
								\textbf{Abstract\quad} & 
								{\abstract} \\%
								\textbf{Highlights\quad} &
								{\highlights} \\%
							\end{tabularx}%
							\par
							\vskip 0.3em%
							\hrule
							\vskip 2em%
						]%
					\else
						\newpage
						\global\@topnum\z@   % Prevents figures from going at top of page.
						\@maketitle
						\hrule
						\vskip 0.3em%
						\begin{tabularx}{\linewidth}{@{}l@{}X@{}}%
							\textbf{Abstract\quad} & 
							{\abstract} \\%
							\textbf{Highlights\quad} &
							{\highlights} \\%
						\end{tabularx}%
						\par
						\vskip 0.3em%
						\hrule
						\vskip 2em%
					\fi
				\fi
		    % If there is an abstract and keywords
	        \else
				% and no highlights
				\ifx\highlights\empty
					\if@twocolumn
						\twocolumn[
							\newpage
							\global\@topnum\z@   % Prevents figures from going at top of page.
							\@maketitle
							\hrule
							\vskip 0.3em%
							\tabcolsep=0.75em
							\begin{tabularx}{\linewidth}{@{}Xl@{}}%
								{\textbf{Abstract}\quad \abstract} & 
