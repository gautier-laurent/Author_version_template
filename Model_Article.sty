\titleformat{\section}[hang]
	{\bfseries \sffamily \large \scshape} % Global style
	{\ifnum\pdfstrcmp{\@currenvir}{appendices}=0
		Appendix~\thesection
	\else
	  	\thesection
	\fi} % Section label style
	{0.6em} % Horizontal space between the label and the chapter title (if using hang)
	{} % Section title style
	
% Modify the subsection titles. % Need the titlesec package.
