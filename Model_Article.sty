\newcommand{\Pages}[2]{\def\artpages{#1--#2}}
\newcommand{\Year}[1]{\def\artyear{#1}}
\newcommand{\DOI}[1]{\def\artdoi{\href{http://dx.doi.org/#1}{#1}}}
\newcommand{\Abstract}[1]{\def\abstract{#1}}
\def\sep{%
	\ifthenelse{\equal{\abstract}{\empty}}{\quad}{\\}
}
\newcommand{\MyKeywords}[1]{\def\mykeywords{
	\ifthenelse{\equal{\abstract}{\empty}}{%
		#1%
	}{%
		\begin{tabular}[t]{@{}l@{}}%
			\textbf{Keywords} \sep%
			#1%
		\end{tabular}%
	}%
}}
\newcommand{\Highlights}[1]{\def\highlights{%
	\ifx\foo#1\foo%
	\else%
			\begin{minipage}[t]{\linewidth}%
				\begin{compactitem}[\ensuremath{\triangleright}]
					#1%
				\end{compactitem}%
			\end{minipage}
	\fi%
}}

\def\maketitle{\par
	\begingroup
		\renewcommand\thefootnote{\@fnsymbol\c@footnote}%
		\def\@makefnmark{\rlap{\@textsuperscript{\normalfont\@thefnmark}}}%
    	\long\def\@makefntext##1{\parindent 1em\noindent
        	\hb@xt@1.8em{%
            	\hss\@textsuperscript{\normalfont\@thefnmark}}##1}% 
		\def\arraystretch{1.3}%
       	\ifx\abstract\empty
       		% If there is no abstract and no keyword
       		\ifx\mykeywords\empty 
				% and no highlights
				\ifx\highlights\empty
					\if@twocolumn
						\twocolumn[
							\newpage
							\global\@topnum\z@   % Prevents figures from going at top of page.
							\@maketitle
							\par
							\vskip 2em%
						]%
					\else
						\newpage
						\global\@topnum\z@   % Prevents figures from going at top of page.
						\@maketitle
						\par
						\vskip 2em%
					\fi
				% no astract, no keyword, but highlights
				\else
					\if@twocolumn
						\twocolumn[
							\newpage
							\global\@topnum\z@   % Prevents figures from going at top of page.
							\@maketitle
							\par
							\hrule
							\vskip 0.3em%
							\begin{tabularx}{\linewidth}{@{}l@{}X@{}}%
								\textbf{Highlights\quad} &
								{\highlights} \\%
							\end{tabularx}%
							\vskip 0.5em%
							\hrule
							\vskip 2em%
						]%
					\else
						\newpage
						\global\@topnum\z@   % Prevents figures from going at top of page.
						\@maketitle
						\par
						\hrule
						\vskip 0.3em%
						\begin{tabularx}{\linewidth}{@{}l@{}X@{}}%
							\textbf{Highlights\quad} &
							{\highlights} \\%
							\textbf{Keywrds\quad} & 
							{\keywords} \\%
						\end{tabularx}%
						\vskip 0.5em%
						\hrule
						\vskip 2em%
					\fi
				\fi
		    % If there is no abstract and keywords
          	\else
				% and no highlights
				\ifx\highlights\empty
					\if@twocolumn
						\twocolumn[
							\newpage
							\global\@topnum\z@   % Prevents figures from going at top of page.
							\@maketitle
							\begin{tabularx}{\linewidth}{@{}l@{}X@{}}%
								&
								\textbf{Keywords\quad} \sep
								{\mykeywords} \\%
							\end{tabularx}%
							\vskip 0.5em%
							\hrule
							\vskip 2em%
						]%
					\else
						\newpage
						\global\@topnum\z@   % Prevents figures from going at top of page.
						\@maketitle
						\begin{tabularx}{\linewidth}{@{}l@{}X@{}}%
							&
							\textbf{Keywords\quad} \sep 
							{\mykeywords} \\%
						\end{tabularx}%
						\vskip 0.5em%
						\hrule
						\vskip 2em%
					\fi
				% no astract, but keyword, and highlights
				\else
					\if@twocolumn
						\twocolumn[
							\newpage
							\global\@topnum\z@   % Prevents figures from going at top of page.
							\@maketitle
							\hrule
							\vskip 0.3em%
							\begin{tabularx}{\linewidth}{@{}l@{}X@{}}%
								\textbf{Highlights\quad} &
								{\highlights} \\%
								\textbf{Keywords\quad} & 
								{\mykeywords} \\%
							\end{tabularx}%
							\par
							\hrule
							\vskip 2em%
						]%
					\else
						\newpage
						\global\@topnum\z@   % Prevents figures from going at top of page.
						\@maketitle
						\hrule
						\vskip 0.3em%
						\begin{tabularx}{\linewidth}{@{}l@{}X@{}}%
							\textbf{Highlights\quad} &
							{\highlights} \\%
							\textbf{Keywords\quad} & 
							{\mykeywords} \\%
						\end{tabularx}%
						\par
						\hrule
						\vskip 2em%
					\fi
				\fi
          	\fi
		\else
			% If there is an abstract and no keyword
	        \ifx\mykeywords\empty
				% and no highlights
				\ifx\highlights\empty
					\if@twocolumn
						\twocolumn[
							\newpage
							\global\@topnum\z@   % Prevents figures from going at top of page.
							\@maketitle
							\hrule
							\vskip 0.3em%
							\begin{tabularx}{\linewidth}{@{}l@{}X@{}}%
								\textbf{Abstract\quad} & 
